<?xml version='1.0' encoding='utf-8'?>
<widget id="com.pbsdigitals.agents" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>PBS Agents</name>
    <description>PBS Digitals Agents Dashboard</description>
    <author email="support@pbsdigitals.com" href="https://pbsdigitals.com">PBS Digitals</author>
    <content src="index.html" />
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-intent href="tel:*" />
    <allow-intent href="sms:*" />
    <allow-intent href="mailto:*" />
    <allow-intent href="geo:*" />
<platform name="android">
        <allow-intent href="market:*" />
        <preference name="GooglePlayServicesVersion" value="@integer/google_play_services_version" />
        <!-- OneSignal Plugin Configuration -->
        <preference name="UseSwiftLanguageVersion" value="5" />
        <preference name="FirebaseAppInvitesEnabled" value="true" />
    </platform>
    
    <!-- OneSignal Plugin -->
    <plugin name="onesignal-cordova-plugin" spec="^5.5.9">
        <variable name="ONESIGNAL_ANDROID_SDK_VERSION" value="5.1.7" />
    </plugin>
    
    <!-- Firebase/Google Play Services -->
    <plugin name="cordova-plugin-firebase-core" spec="^1.4.0" />
    
    <!-- Notification Permissions -->
    <plugin name="cordova-plugin-android-permissions" spec="^1.1.5" />
    <preference name="loglevel" value="debug" />
    <preference name="orientation" value="portrait" />
    <preference name="Fullscreen" value="true" />
    <preference name="DisallowOverscroll" value="true" />
    <variable name="GRADLE_TOOLS_VERSION" value="8.1.0" />
    <variable name="ANDROID_GRADLE_PLUGIN_VERSION" value="8.1.0" />
</widget>
